# Google OAuth app credentials. Keep these local for the import/upload/delete CLI.
# The import command uses Google Drive Picker so you can link photos from a folder you already own.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=https://www.carrels.photography,https://carrels.photography,http://localhost:8000,http://127.0.0.1:8000
